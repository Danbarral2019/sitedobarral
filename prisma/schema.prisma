// Artigos da Lei 14.133/2021 - Nova Lei de Licitações
// Armazena os 195 artigos (193 + Art. 184-A + Art. 194) para permitir edição via admin
model LeiArticle {
  id               String   @id @default(uuid())
  numero           String   @unique // "1", "2", "3", etc.
  titulo           String?  // "TÍTULO I - DISPOSIÇÕES PRELIMINARES"
  capituloCompleto String?  // "CAPÍTULO I - DO ÂMBITO DE APLICAÇÃO DESTA LEI"
  ementa           String   @db.Text // Texto completo do artigo
  capitulo         String   // "TÍTULO I - CAPÍTULO I"
  secao            String?  // "Disposições Preliminares"

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([numero])
  @@index([capitulo])
}

// Histórico de Pesquisas IA (para alunos retomarem consultas)
model SearchHistory {
  id           String   @id @default(uuid())
  userId       String
  query        String
  aiAnswer     String?  @db.Text
  sources      String?  // JSON: [{title, category, url}]
  legalSources String?  // JSON: [{type, title, url}]
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId])
}

// Fila de Indexação (Background Jobs para Embeddings)
// Processa geração de embeddings de forma assíncrona
model IndexJob {
  id            String   @id @default(uuid())

  // Tipo de conteúdo a indexar
  entityType    String   // 'document' | 'glossary' | 'lei-article' | 'blog-post'
  entityId      String   // ID da entidade (Document, GlossaryTerm, LeiArticle, BlogPost)

  // Status do job
  status        String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  priority      Int      @default(0) // Maior = mais prioritário (0-10)

  // Dados para indexação
  r2Key         String?  // Chave R2 do arquivo (para documents)
  textContent   String?  @db.Text // Conteúdo textual já extraído (para otimização)
  metadata      String?  @db.Text // Metadados adicionais em JSON

  // Controle de reprocessamento
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  lastError     String?  @db.Text

  // Timestamps
  createdAt     DateTime @default(now())
  processedAt   DateTime? // Quando foi processado
  scheduledFor  DateTime? // Para agendamento futuro (opcional)

  @@index([status])
  @@index([priority, status])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([scheduledFor])
}

// ============================================================================
// LMS — Módulos e Lições
// ============================================================================

// Módulo: subdivisão de um curso
model Module {
  id           String   @id @default(uuid())
  courseId      String
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@index([courseId, displayOrder])
}

// Lição: unidade de aprendizagem dentro de um módulo
model Lesson {
  id               String   @id @default(uuid())
  moduleId         String
  module           Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String?  @db.Text
  content          String?  @db.Text
  displayOrder     Int      @default(0)
  isPublished      Boolean  @default(false)
  estimatedMinutes Int?
  requiresQuizPass Boolean  @default(false)

  // Campos IA
  aiSummary   String? @db.Text
  aiKeyPoints String? // JSON array
  leiArticles String? // JSON array com números de artigos da Lei 14.133/2021

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents LessonDocument[]
  videos    LessonVideo[]
  progress  LessonProgress[]
  comments  LessonComment[]
  quiz      Quiz?

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@index([moduleId, displayOrder])
}

// Junction: Lesson ↔ Document
model LessonDocument {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  displayOrder Int     @default(0)
  isRequired  Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([lessonId, documentId])
  @@index([lessonId])
  @@index([documentId])
}

// Junction: Lesson ↔ Vídeo
model LessonVideo {
  id            String       @id @default(uuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseVideoId String?
  courseVideo   CourseVideo?  @relation(fields: [courseVideoId], references: [id], onDelete: SetNull)
  title         String
  youtubeUrl    String
  youtubeId     String
  description   String?
  displayOrder  Int          @default(0)
  isRequired    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([lessonId])
  @@index([courseVideoId])
}

// Progresso do aluno por lição
model LessonProgress {
  id               String    @id @default(uuid())
  userId           String
  lessonId         String
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status           String    @default("not_started") // not_started | in_progress | completed
  startedAt        DateTime?
  completedAt      DateTime?
  lastAccessedAt   DateTime?
  timeSpentSeconds Int       @default(0)
  contentRead      Boolean   @default(false)
  videosWatched    String?   // JSON array de videoIds
  documentsViewed  String?   // JSON array de documentIds
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, status])
}

// Discussão por lição (threaded)
model LessonComment {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  parentId  String?
  parent    LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LessonComment[] @relation("CommentReplies")
  content   String   @db.Text
  isEdited  Boolean  @default(false)
  isPinned  Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
  @@index([lessonId, isPinned])
}

// ============================================================================
// LMS — Quizzes e Certificados (Fase 2)
// ============================================================================

// Quiz vinculado a uma lição (1:1, opcional)
model Quiz {
  id                String   @id @default(uuid())
  lessonId          String   @unique
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title             String
  description       String?  @db.Text
  passingScore      Int      @default(60) // Nota mínima (0-100)
  maxAttempts       Int?     // null = ilimitado
  timeLimitMinutes  Int?     // null = sem tempo limite
  shuffleQuestions  Boolean  @default(false)
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
}

// Pergunta de quiz
model QuizQuestion {
  id           String   @id @default(uuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type         String   // multiple_choice | true_false
  text         String   @db.Text
  options      String   @db.Text // JSON array: [{id, text, isCorrect}]
  explanation  String?  @db.Text
  displayOrder Int      @default(0)
  points       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([quizId])
  @@index([quizId, displayOrder])
}

// Tentativa de quiz do aluno
model QuizAttempt {
  id               String    @id @default(uuid())
  quizId           String
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String
  answers          String    @db.Text // JSON: [{questionId, selectedOptionId}]
  score            Float     // 0-100
  totalPoints      Int
  maxPoints        Int
  passed           Boolean
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  timeSpentSeconds Int?
  createdAt        DateTime  @default(now())

  @@index([quizId])
  @@index([userId])
  @@index([quizId, userId])
}

// Certificado de conclusão de curso
model Certificate {
  id                String    @id @default(uuid())
  userId            String
  courseId           String
  certificateNumber String    @unique // BARRAL-{ANO}-{SEQUENCIA}
  studentName       String
  courseTitle        String
  estimatedHours    Int?
  issuedAt          DateTime  @default(now())
  emailSentAt       DateTime?
  createdAt         DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([certificateNumber])
}

// ============================================================================
// LMS — Gamificação (Fase 4)
// ============================================================================

// Badges conquistados pelos alunos
model Badge {
  id        String   @id @default(uuid())
  userId    String
  courseId   String?
  type      String   // first_lesson, first_quiz, module_complete, course_complete, streak_7, streak_30, contributor, best_answer
  metadata  String?  // JSON: {moduleName, quizTitle, etc}
  awardedAt DateTime @default(now())

  @@unique([userId, type, courseId])
  @@index([userId])
  @@index([courseId])
}

// Streak e XP do aluno por curso
model UserStreak {
  id                String   @id @default(uuid())
  userId            String
  courseId           String
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActivityDate  String?  // YYYY-MM-DD (evita timezone issues)
  totalXp           Int      @default(0)
  showOnLeaderboard Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, totalXp])
  @@index([courseId, showOnLeaderboard])
}

// Destaques TCU - Acórdãos com potencial editorial identificados pela IA
model TcuHighlight {
  id                  String    @id @default(uuid())
  documentId          String
  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Scores
  keywordScore        Int       // Score original do analyzeRelevanceTCU
  aiArticleWorthiness Int       // Score geral 0-100 da IA

  // Análise IA
  aiThesisSummary     String    @db.Text  // Tese principal em linguagem acessível
  aiWhyImportant      String    @db.Text  // Por que merece destaque
  aiArticleAngle      String    @db.Text  // Sugestão de ângulo editorial
  aiLeiConnections    String?             // JSON: [{article, connection}]

  // Workflow admin
  status              String    @default("pending") // pending | dismissed | will_write | written
  adminNotes          String?   @db.Text
  blogPostId          String?   // Link ao post criado

  // Notificação
  emailSentAt         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([documentId])
}

// Assinaturas Stripe (planos mensais)
model Subscription {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String   @unique
  stripePriceId          String
  plan                   String   // 'basico' | 'premium'
  courseId                String?  // Para plano 'basico' — qual curso
  status                 String   // 'active' | 'canceled' | 'past_due' | 'unpaid'
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([userId, status])
}

// Embeddings pré-computados dos artigos da Lei 14.133/2021 (Fase 5B)
// Permite busca semântica direta contra a query do usuário
model LeiArticleEmbedding {
  id            String   @id @default(uuid())
  articleNumber String   @unique
  content       String   @db.Text
  embedding     Unsupported("vector(768)")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([articleNumber])
}

// Notas de alteração em artigos da Lei 14.133/2021
// Criadas automaticamente quando um novo ato (DOU) altera/regulamenta um artigo
model LeiArticleNote {
  id              String   @id @default(uuid())
  articleNumber   String   // "75", "184-A"
  type            String   // 'alteracao' | 'regulamentacao' | 'revogacao' | 'comentario'
  title           String   // "Alterado pelo Decreto 11.878/2024"
  description     String?  @db.Text
  sourceDocId     String?  // FK para Document (ato que gerou a nota)
  sourceLegActId  String?  // FK para LegislativeAct
  detectedBy      String   // 'auto-sync-dou' | admin email
  isPublic        Boolean  @default(false) // Visível aos alunos?
  adminReviewed   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([articleNumber])
  @@index([type])
  @@index([adminReviewed])
}

// Push Notification Subscriptions (PWA)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
