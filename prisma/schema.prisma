// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Para desenvolvimento local com SQLite, altere provider para "sqlite"
  // e DATABASE_URL para "file:./dev.db"
}

// QR Codes para acesso aos cursos
model QRCode {
  id          String   @id @default(uuid())
  code        String   @unique
  qrCodeImage String?  // Imagem do QR Code em base64
  courseId    String
  turma       String
  validUntil  DateTime
  maxUses     Int?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([validUntil])
  @@index([courseId, turma])
}

// Documentos dos cursos
model Document {
  id              String   @id @default(uuid())
  title           String
  description     String?
  type            String   // pdf, doc, link, video
  url             String   // URL principal do documento
  alternativeUrls String?  // JSON array com URLs alternativas (ex: múltiplas fundamentações)
  category        String   // apostila, acordao, parecer, edital, artigo, outro
  courseId        String?  // NULL se isCommon=true (disponível para todos os cursos)
  isPublic        Boolean  @default(false)
  isCommon        Boolean  @default(false) // Se true, documento aparece em todos os cursos
  tags            String?  // JSON array como string
  leiArticles     String?  // JSON array com números de artigos da Lei 14.133/2021
  size            Int?
  onNumber        Int?     // Número da ON (para ordenação numérica de Orientações Normativas)
  onYear          Int?     // Ano da ON (para ordenação numérica de Orientações Normativas)
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  notifiedAt      DateTime? // Data em que os alunos foram notificados sobre este documento
  reviewed        Boolean  @default(false) // Se o documento já foi revisado por um humano
  reviewedAt      DateTime? // Data em que o documento foi revisado

  // Sistema de Feedback de IA/ML (Fase 3D)
  aiClassification    String?   // JSON com classificação da IA (category, courses, tags, confidence, reasoning)
  feedbackRelevance   String?   // 'relevant' | 'irrelevant' | 'partially-relevant' (feedback do admin)
  feedbackReasoning   String?   // Explicação do admin sobre a relevância
  feedbackGivenAt     DateTime? // Data do feedback
  feedbackGivenBy     String?   // Email do admin que deu o feedback
  aiSuggestedArticles String?   // JSON array com artigos da Lei 14.133 sugeridos pela IA

  // Sistema de Resumos Automáticos (IA)
  summary             String?   // Resumo executivo gerado pela IA
  summaryHighlights   String?   // JSON array com destaques principais
  summaryGeneratedAt  DateTime? // Data de geração do resumo
  summaryEditedByAdmin Boolean @default(false) // Se o resumo foi editado manualmente pelo admin

  // Sistema de Enunciados (IBDA, INCP, CJF)
  entityType          String?   // Entidade responsável: "IBDA", "INCP", "CJF" (apenas para categoria="enunciados")
  enunciadoNumber     String?   // Número do enunciado (formato flexível: "123", "123/2024", ou texto livre)

  // Sistema de Observações Estruturadas (para acórdãos e outros documentos)
  adminNotes          String?   // Observações privadas do admin (não visíveis aos alunos)
  publicNotes         String?   // Observações públicas (visíveis aos alunos)
  notesImportance     String?   // 'baixa' | 'media' | 'alta' | 'critica'
  notesRelatedDocs    String?   // JSON array com IDs de documentos relacionados
  notesPracticalUse   String?   // Aplicação prática do documento
  notesKeyPoints      String?   // Pontos-chave para destacar
  notesUpdatedAt      DateTime? // Data da última atualização das observações
  notesUpdatedBy      String?   // Email do admin que atualizou

  // Sistema de Dados TCU (importação enriquecida de acórdãos)
  tcuNumeroAcordao    String?   // Número do acórdão (ex: AC-1106/24-P)
  tcuAutorTese        String?   // Autor da tese (ex: AUGUSTO SHERMAN)
  tcuArea             String?   // Área temática (ex: Contrato Administrativo)
  tcuTema             String?   // Tema específico (ex: Formalização do contrato)
  tcuSubtema          String?   // Subtema (ex: Cláusula obrigatória)
  tcuLegislacao       String?   @db.Text // Legislação citada (pode ser longa)
  tcuIndexadores      String?   // Indexadores/tags originais da planilha TCU
  tcuTipoProcesso     String?   // Tipo do processo (ex: CONSULTA)
  tcuDataJulgamento   DateTime? // Data do julgamento do acórdão
  tcuLinkPDF          String?   // Link oficial do PDF no site do TCU
  tcuEmentaCompleta   String?   @db.Text // Ementa oficial completa (pode ser longa)
  tcuTextoCompleto    String?   @db.Text // Texto integral do acórdão (pode ser muito longo)
  tcuRelator          String?   // Nome do relator
  tcuOrgaoJulgador    String?   // Órgão julgador (Plenário, 1ª Câmara, etc)

  // Metadados de processamento TCU
  tcuEnriquecidoEm    DateTime? // Data do enriquecimento automático via scraper
  tcuEnriquecimentoStatus String? // 'success' | 'failed' | 'pending'
  tcuEnriquecimentoErro String? // Mensagem de erro caso o enriquecimento falhe
  tcuClassificadoEm   DateTime? // Data da classificação pela IA
  tcuRevisadoPorAdmin Boolean @default(false) // Se o documento foi revisado manualmente pelo admin após enriquecimento

  @@index([courseId])
  @@index([category])
  @@index([courseId, isPublic])
  @@index([uploadedAt])
  @@index([notifiedAt])
  @@index([courseId, notifiedAt])
  @@index([isCommon]) // Índice para buscar documentos comuns rapidamente
  @@index([category, onNumber, onYear]) // Índice para ordenação numérica de ONs
  @@index([reviewed]) // Índice para buscar documentos não revisados
  @@index([reviewed, uploadedAt]) // Índice para ordenar documentos não revisados por data
  @@index([feedbackRelevance]) // Índice para filtrar por feedback
  @@index([summary]) // Índice para buscar documentos com/sem resumo
  @@index([summaryGeneratedAt]) // Índice para ordenar por data de geração de resumo
  @@index([entityType]) // Índice para filtrar enunciados por entidade
  @@index([category, entityType]) // Índice composto para filtrar enunciados
  @@index([title]) // Índice para busca rápida por título/número do acórdão (detecção de duplicatas)
  @@index([category, title]) // Índice composto para busca de acórdãos específicos
  @@index([notesImportance]) // Índice para filtrar por importância das observações
  @@index([tcuNumeroAcordao]) // Índice para buscar acórdãos pelo número
  @@index([tcuAutorTese]) // Índice para filtrar por autor da tese
  @@index([tcuArea, tcuTema]) // Índice composto para buscar por área e tema
  @@index([tcuEnriquecimentoStatus]) // Índice para filtrar documentos por status de enriquecimento
  @@index([tcuRevisadoPorAdmin]) // Índice para filtrar documentos revisados após enriquecimento
}

// Usuários (admin e estudantes)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   // admin, student

  // Verificação de email
  emailVerified         Boolean   @default(false)
  verificationToken     String?   @unique
  verificationExpiry    DateTime?

  // Recuperação de senha
  resetPasswordToken    String?   @unique
  resetPasswordExpiry   DateTime?

  // Relacionamento com cursos (para estudantes)
  enrollments  Enrollment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Índices para otimização de queries
  @@index([role])                    // Para filtrar admins/students
  @@index([email, role])             // Para queries de autenticação
  @@index([emailVerified])           // Para filtrar usuários verificados
  @@index([createdAt])               // Para ordenação por data
}

// Matrícula de aluno em curso (via QR Code)
model Enrollment {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  turma               String?
  qrCodeId            String?   // QR Code usado no primeiro acesso
  enrolledAt          DateTime  @default(now())
  expiresAt           DateTime? // Data de expiração (1 ano após criação do QR Code da turma)
  isLifetime          Boolean   @default(false) // Acesso vitalício
  lifetimeUpgradedAt  DateTime? // Data do upgrade para vitalício
  lifetimePrice       Float?    // Valor pago pelo upgrade vitalício
  notificationSentAt  DateTime? // Data em que notificação de expiração foi enviada

  @@unique([userId, courseId])

  // Índices para otimização de queries
  @@index([userId])                                      // Para buscar matrículas por usuário
  @@index([courseId])                                    // Para buscar matrículas por curso
  @@index([userId, courseId, isLifetime])                // Para verificações de acesso
  @@index([expiresAt, isLifetime, notificationSentAt])   // Para cron job de notificações
  @@index([isLifetime])                                  // Para estatísticas de upgrades
  @@index([enrolledAt])                                  // Para ordenação por data
}

// Log de acessos (para auditoria)
model AccessLog {
  id         String   @id @default(uuid())
  userId     String?
  qrCode     String?
  courseId   String?
  documentId String?  // ID do documento acessado/baixado
  action     String   // login, access, download, view
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, action])
  @@index([courseId, createdAt])
  @@index([documentId])
}

// Favoritos dos usuários
model Favorite {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  courseId   String   // Para facilitar filtros por curso
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
  @@index([userId])
  @@index([courseId])
}

// Posts do Blog
model BlogPost {
  id                 String             @id @default(uuid())
  slug               String             @unique
  title              String
  excerpt            String
  content            String             // Texto longo do artigo
  author             String
  publishedAt        DateTime
  isPublished        Boolean            @default(false)
  tags               String?            // JSON array como string
  leiArticles        String?            // JSON array com números de artigos da Lei 14.133/2021
  autoPublishSocial  Boolean            @default(true) // Publicar automaticamente nas redes sociais
  socialMediaImage   String?            // URL da imagem gerada para OG/redes sociais
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  socialMediaPosts   SocialMediaPost[]  // Relação com publicações sociais

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
}

// Publicações em Redes Sociais
model SocialMediaPost {
  id          String    @id @default(uuid())
  blogPostId  String
  platform    String    // 'instagram' | 'linkedin' | 'twitter'
  postId      String?   // ID do post na rede social
  postUrl     String?   // URL do post publicado
  status      String    @default("pending") // 'pending' | 'published' | 'failed'
  error       String?   // Mensagem de erro se falhar
  retryCount  Int       @default(0) // Número de tentativas
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blogPost    BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([platform])
  @@index([status])
  @@index([publishedAt])
}

// Publicações Acadêmicas (Livros, Artigos, Notícias)
model Publication {
  id          String   @id @default(uuid())
  type        String   // livro, artigo, noticia
  title       String
  description String   // Resumo/descrição
  content     String?  // Conteúdo completo (opcional para artigos externos)
  author      String
  publishedAt DateTime
  isPublished Boolean  @default(false)

  // Campos específicos para livros
  publisher   String?  // Editora
  isbn        String?  // ISBN
  coverImage  String?  // URL da imagem de capa

  // Campos para artigos/links externos
  externalUrl String?  // Link para artigo externo
  journal     String?  // Nome da revista/jornal

  // Campos para notícias/eventos
  eventDate   DateTime? // Data do evento
  location    String?   // Local do evento

  // Catalogação por artigos da Lei 14.133/2021
  leiArticles String?   // JSON array com números de artigos da Lei 14.133/2021

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([type, isPublished])
}

// Formulário de Contato
model ContactForm {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  courseInterest String?  // Nome do curso de interesse
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// Newsletter - Cadastro de Interessados
model NewsletterSubscriber {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  interests      String?  // JSON array com temas de interesse
  isActive       Boolean  @default(true)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([isActive])
  @@index([subscribedAt])
}

// Depoimentos/Testemunhos de Alunos
model Testimonial {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  role           String   // Cargo/função da pessoa
  text           String   // Texto do depoimento
  rating         Int      @default(5) // Avaliação de 1-5 estrelas
  avatar         String   @default("U") // Inicial para avatar
  color          String   @default("from-blue-400 to-blue-600") // Cor do avatar

  // Status de moderação
  status         String   @default("pending") // pending, approved, rejected
  moderatedBy    String?  // ID do admin que moderou
  moderatedAt    DateTime?
  rejectionReason String? // Motivo da rejeição (se aplicável)

  // Relacionamento com formulário de contato (opcional)
  contactFormId  String?  @unique

  // Relacionamento com usuário (se for um aluno logado)
  userId         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Sites Recomendados (compartilhados entre cursos)
model RecommendedSite {
  id          String   @id @default(uuid())
  title       String   // Nome do site
  description String   // Breve descrição do site
  url         String   // URL completa do site
  faviconUrl  String?  // URL do favicon (buscado automaticamente)
  category    String?  // Categoria opcional (jurisprudência, legislação, etc.)
  displayOrder Int     @default(0) // Ordem de exibição
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relação many-to-many com cursos
  courses     SiteToCourse[]

  @@index([isActive])
  @@index([displayOrder])
}

// Tabela de junção: Sites x Cursos (many-to-many)
model SiteToCourse {
  id             String          @id @default(uuid())
  siteId         String
  courseId       String
  displayOrder   Int             @default(0) // Ordem específica para este curso
  createdAt      DateTime        @default(now())

  site           RecommendedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, courseId])
  @@index([courseId])
  @@index([siteId])
}

// Vídeos do YouTube por curso
model CourseVideo {
  id            String   @id @default(uuid())
  courseId      String   // ID do curso (da lista estática)
  title         String   // Título do vídeo
  description   String?  // Descrição do vídeo
  youtubeUrl    String   // URL completa do YouTube
  youtubeId     String   // ID extraído do YouTube (para embed)
  thumbnailUrl  String?  // URL da thumbnail (gerado automaticamente)
  displayOrder  Int      @default(0) // Ordem de exibição
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId])
  @@index([isActive])
  @@index([courseId, isActive, displayOrder])
}

// Analytics de análises automáticas de documentos
model DocumentAnalysis {
  id                String   @id @default(uuid())
  documentId        String?  // ID do documento criado (null se ainda não criado)
  documentTitle     String   // Título do documento analisado
  documentType      String?  // Tipo de arquivo (pdf, docx, etc.)

  // Dados da análise
  textLength        Int      // Quantidade de texto analisado
  pageCount         Int?     // Número de páginas (se PDF)
  citationsFound    Int      @default(0) // Artigos citados explicitamente
  keywordsMatched   Int      @default(0) // Palavras-chave encontradas

  // Sugestões geradas
  suggestedArticles String   // JSON array com artigos sugeridos
  totalSuggestions  Int      @default(0) // Total de sugestões geradas

  // Resultados (o que o usuário aceitou)
  acceptedArticles  String?  // JSON array com artigos aceitos
  acceptedCount     Int      @default(0) // Quantos foram aceitos

  // Métricas calculadas
  precision         Float?   // % de sugestões aceitas (precision)

  // Metadados
  createdAt         DateTime @default(now())
  userId            String?  // Quem fez a análise (opcional)

  @@index([createdAt])
  @@index([documentId])
  @@index([userId])
}
