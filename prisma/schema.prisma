// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Para desenvolvimento local com SQLite, altere provider para "sqlite"
  // e DATABASE_URL para "file:./dev.db"
}

// QR Codes para acesso aos cursos
model QRCode {
  id          String   @id @default(uuid())
  code        String   @unique
  qrCodeImage String?  // Imagem do QR Code em base64
  courseId    String
  turma       String
  validUntil  DateTime
  maxUses     Int?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([validUntil])
  @@index([courseId, turma])
}

// Documentos dos cursos
model Document {
  id              String   @id @default(uuid())
  title           String
  description     String?
  type            String   // pdf, doc, link, video
  url             String   // URL principal do documento
  alternativeUrls String?  // JSON array com URLs alternativas (ex: múltiplas fundamentações)
  category        String   // apostila, acordao, parecer, edital, artigo, outro
  courseId        String?  // NULL se isCommon=true (disponível para todos os cursos)
  isPublic        Boolean  @default(false)
  isCommon        Boolean  @default(false) // Se true, documento aparece em todos os cursos
  tags            String?  // JSON array como string
  leiArticles     String?  // JSON array com números de artigos da Lei 14.133/2021
  content         String?  @db.Text // Conteúdo/trechos relevantes do documento para busca textual
  size            Int?
  onNumber        Int?     // Número da ON (para ordenação numérica de Orientações Normativas)
  onYear          Int?     // Ano da ON (para ordenação numérica de Orientações Normativas)
  acordaoNumero   Int?     // Número do Acórdão TCU (para ordenação numérica de Acórdãos)
  acordaoAno      Int?     // Ano do Acórdão TCU (para ordenação numérica de Acórdãos)
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  notifiedAt      DateTime? // Data em que os alunos foram notificados sobre este documento
  reviewed        Boolean  @default(false) // Se o documento já foi revisado por um humano
  reviewedAt      DateTime? // Data em que o documento foi revisado
  reviewedBy      String?   // Email do admin que aprovou/rejeitou o documento (✅ FIX #5: Audit trail)

  // Sistema de Feedback de IA/ML (Fase 3D)
  aiClassification    String?   // JSON com classificação da IA (category, courses, tags, confidence, reasoning)
  feedbackRelevance   String?   // 'relevant' | 'irrelevant' | 'partially-relevant' (feedback do admin)
  feedbackReasoning   String?   // Explicação do admin sobre a relevância
  feedbackGivenAt     DateTime? // Data do feedback
  feedbackGivenBy     String?   // Email do admin que deu o feedback
  aiSuggestedArticles String?   // JSON array com artigos da Lei 14.133 sugeridos pela IA

  // Sistema de Resumos Automáticos (IA)
  summary             String?   // Resumo executivo gerado pela IA
  summaryHighlights   String?   // JSON array com destaques principais
  summaryGeneratedAt  DateTime? // Data de geração do resumo
  summaryEditedByAdmin Boolean @default(false) // Se o resumo foi editado manualmente pelo admin

  // Sistema de Enunciados (IBDA, INCP, CJF)
  entityType          String?   // Entidade responsável: "IBDA", "INCP", "CJF" (apenas para categoria="enunciados")
  enunciadoNumber     String?   // Número do enunciado (formato flexível: "123", "123/2024", ou texto livre)

  // Classificação para boas práticas e filtros avançados
  issuerOrg           String?   // Órgão emissor (para boa_pratica: "TCE-SP", "CGE-MG", etc.)
  esfera              String?   // "federal" | "estadual"
  themes              String?   // JSON array: ["planejamento","contratos"]

  // Sistema de Links DOU (Diário Oficial da União)
  douUrl              String?   // URL da publicação no DOU (Diário Oficial da União)
  douData             DateTime? // Data de publicação no DOU
  douSecao            String?   // Seção do DOU (1, 2, 3)
  douPagina           String?   // Página no DOU
  douEdicao           String?   // Edição/número do DOU

  // Sistema de Observações Estruturadas (para acórdãos e outros documentos)
  adminNotes          String?   // Observações privadas do admin (não visíveis aos alunos)
  publicNotes         String?   // Observações públicas (visíveis aos alunos)
  notesImportance     String?   // 'baixa' | 'media' | 'alta' | 'critica'
  notesRelatedDocs    String?   // JSON array com IDs de documentos relacionados
  notesPracticalUse   String?   // Aplicação prática do documento
  notesKeyPoints      String?   // Pontos-chave para destacar
  notesUpdatedAt      DateTime? // Data da última atualização das observações
  notesUpdatedBy      String?   // Email do admin que atualizou

  // Sistema de Dados TCU (importação enriquecida de acórdãos)
  tcuNumeroAcordao    String?   // Número do acórdão (ex: AC-1106/24-P)
  tcuAutorTese        String?   // Autor da tese (ex: AUGUSTO SHERMAN)
  tcuArea             String?   // Área temática (ex: Contrato Administrativo)
  tcuTema             String?   // Tema específico (ex: Formalização do contrato)
  tcuSubtema          String?   // Subtema (ex: Cláusula obrigatória)
  tcuLegislacao       String?   @db.Text // Legislação citada (pode ser longa)
  tcuIndexadores      String?   // Indexadores/tags originais da planilha TCU
  tcuTipoProcesso     String?   // Tipo do processo (ex: CONSULTA)
  tcuDataJulgamento   DateTime? // Data do julgamento do acórdão
  tcuLinkPDF          String?   // Link oficial do PDF no site do TCU
  tcuEmentaCompleta   String?   @db.Text // Ementa oficial completa (pode ser longa)
  tcuTextoCompleto    String?   @db.Text // Texto integral do acórdão (pode ser muito longo)
  tcuRelator          String?   // Nome do relator
  tcuOrgaoJulgador    String?   // Órgão julgador (Plenário, 1ª Câmara, etc)

  // Metadados de processamento TCU
  tcuEnriquecidoEm    DateTime? // Data do enriquecimento automático via scraper
  tcuEnriquecimentoStatus String? // 'success' | 'failed' | 'pending'
  tcuEnriquecimentoErro String? // Mensagem de erro caso o enriquecimento falhe
  tcuClassificadoEm   DateTime? // Data da classificação pela IA
  tcuRevisadoPorAdmin Boolean @default(false) // Se o documento foi revisado manualmente pelo admin após enriquecimento

  // Cloudflare R2 Storage (Fase 8)
  r2Key               String?   // Chave do arquivo no R2 (ex: "documents/1/uuid-filename.pdf")
  r2UploadedAt        DateTime? // Data de upload para R2
  r2MigratedFrom      String?   // Path original no filesystem (para auditoria de migração)

  @@index([courseId])
  @@index([category])
  @@index([courseId, isPublic])
  @@index([uploadedAt])
  @@index([notifiedAt])
  @@index([courseId, notifiedAt])
  @@index([isCommon]) // Índice para buscar documentos comuns rapidamente
  @@index([isCommon, isPublic]) // Índice composto para filtrar documentos comuns e públicos
  @@index([category, onNumber, onYear]) // Índice para ordenação numérica de ONs
  @@index([category, acordaoNumero, acordaoAno]) // Índice para ordenação numérica de Acórdãos TCU
  @@index([reviewed]) // Índice para buscar documentos não revisados
  @@index([reviewed, uploadedAt]) // Índice para ordenar documentos não revisados por data
  @@index([feedbackRelevance]) // Índice para filtrar por feedback
  @@index([summary]) // Índice para buscar documentos com/sem resumo
  @@index([summaryGeneratedAt]) // Índice para ordenar por data de geração de resumo
  @@index([entityType]) // Índice para filtrar enunciados por entidade
  @@index([category, entityType]) // Índice composto para filtrar enunciados
  @@index([title]) // Índice para busca rápida por título/número do acórdão (detecção de duplicatas)
  @@index([category, title]) // Índice composto para busca de acórdãos específicos
  @@index([notesImportance]) // Índice para filtrar por importância das observações
  @@index([tcuNumeroAcordao]) // Índice para buscar acórdãos pelo número
  @@index([tcuAutorTese]) // Índice para filtrar por autor da tese
  @@index([tcuArea, tcuTema]) // Índice composto para buscar por área e tema
  @@index([tcuEnriquecimentoStatus]) // Índice para filtrar documentos por status de enriquecimento
  @@index([tcuRevisadoPorAdmin]) // Índice para filtrar documentos revisados após enriquecimento
  @@index([douData]) // Índice para ordenar por data de publicação no DOU
  @@index([douSecao]) // Índice para filtrar por seção do DOU
  @@index([category, douData]) // Índice composto para buscar documentos por categoria e data DOU
  @@index([r2Key]) // Índice para buscar por chave R2

  // Sistema de Embeddings/Busca Semântica
  extractedText      String?   @db.Text // Texto extraído do documento
  textExtractedAt    DateTime? // Data de extração do texto
  embeddingStatus    String?   @default("pending") // pending|processing|completed|failed
  embeddingError     String?   // Mensagem de erro de embedding (se houver)
  chunkCount         Int?      // Número de chunks gerados
  embeddedAt         DateTime? // Data em que os embeddings foram gerados

  // Relacionamento com versões históricas
  versions DocumentVersion[]

  // Relacionamento com chunks (embeddings)
  chunks DocumentChunk[]

  // Relacionamento com favoritos
  favorites Favorite[]

  // Relacionamento com lições (LMS)
  lessonDocuments LessonDocument[]

  // Relacionamento com destaques TCU
  highlights TcuHighlight[]

  // Full-Text Search (gerido via triggers SQL, não pelo Prisma)
  search_vector Unsupported("tsvector")?

  @@index([embeddingStatus]) // Índice para buscar documentos por status de embedding
}

// Chunks de documentos com embeddings (Busca Semântica)
model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex  Int      // Posição no documento (0, 1, 2...)
  content     String   @db.Text // Conteúdo do chunk
  charStart   Int      // Posição inicial no texto original
  charEnd     Int      // Posição final no texto original
  embedding   Unsupported("vector(768)") // Embedding do Gemini text-embedding-004

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([documentId])
}

// Histórico de versões de documentos (para rastreamento de mudanças)
model DocumentVersion {
  id              String   @id @default(uuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Versão do documento
  versionNumber   Int      // 1, 2, 3, etc

  // Snapshot dos dados nesta versão
  title           String
  description     String   @db.Text
  url             String
  urlPDF          String?
  category        String
  tags            String   // JSON array as string

  // Campos específicos AGU
  onNumber        Int?
  onYear          Int?
  alternativeUrls String?  @db.Text // JSON array

  // Metadados de mudança
  changeType      String   // 'created' | 'updated' | 'minor_update' | 'major_update'
  changesSummary  String?  @db.Text // Resumo das mudanças desta versão
  changeDetails   String?  @db.Text // JSON com diff detalhado

  // Rastreamento
  detectedAt      DateTime @default(now())
  detectedBy      String?  // 'scraper' | 'admin' | email do admin

  // Flags
  isCurrentVersion Boolean @default(false) // Se é a versão atual

  @@index([documentId])
  @@index([documentId, versionNumber])
  @@index([detectedAt])
  @@index([isCurrentVersion])
}

// Usuários (admin e estudantes)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   // admin, student

  // Verificação de email
  emailVerified         Boolean   @default(false)
  verificationToken     String?   @unique
  verificationExpiry    DateTime?

  // Recuperação de senha
  resetPasswordToken    String?   @unique
  resetPasswordExpiry   DateTime?

  // Relacionamento com cursos (para estudantes)
  enrollments  Enrollment[]

  // Stripe
  stripeCustomerId  String?        @unique
  subscriptions     Subscription[]

  // LMS
  lmsReminderSentAt DateTime? // Último lembrete de inatividade LMS enviado

  // Push Notifications
  pushSubscriptions PushSubscription[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Índices para otimização de queries
  @@index([role])                    // Para filtrar admins/students
  @@index([email, role])             // Para queries de autenticação
  @@index([emailVerified])           // Para filtrar usuários verificados
  @@index([createdAt])               // Para ordenação por data
}

// Matrícula de aluno em curso (via QR Code)
model Enrollment {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  turma               String?
  qrCodeId            String?   // QR Code usado no primeiro acesso
  enrolledAt          DateTime  @default(now())
  expiresAt           DateTime? // Data de expiração (1 ano após criação do QR Code da turma)
  isLifetime          Boolean   @default(false) // Acesso vitalício
  lifetimeUpgradedAt  DateTime? // Data do upgrade para vitalício
  lifetimePrice       Float?    // Valor pago pelo upgrade vitalício
  notificationSentAt  DateTime? // Data em que notificação de expiração foi enviada

  @@unique([userId, courseId])

  // Índices para otimização de queries
  @@index([userId])                                      // Para buscar matrículas por usuário
  @@index([courseId])                                    // Para buscar matrículas por curso
  @@index([userId, courseId, isLifetime])                // Para verificações de acesso
  @@index([expiresAt, isLifetime])                        // Para queries de expiração
  @@index([expiresAt, isLifetime, notificationSentAt])   // Para cron job de notificações
  @@index([isLifetime])                                  // Para estatísticas de upgrades
  @@index([enrolledAt])                                  // Para ordenação por data
}

// Log de acessos (para auditoria)
model AccessLog {
  id         String   @id @default(uuid())
  userId     String?
  qrCode     String?
  courseId   String?
  documentId String?  // ID do documento acessado/baixado
  action     String   // login, access, download, view
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, action])
  @@index([courseId, createdAt])
  @@index([documentId])
}

// Favoritos dos usuários
model Favorite {
  id                 String   @id @default(uuid())
  userId             String

  // Suporta dois tipos de favoritos: documentos OU atos normativos
  documentId         String?  // ID do documento (se for documento)
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  legislativeActId   String?  // ID do ato normativo (se for ato)
  legislativeAct     LegislativeAct? @relation(fields: [legislativeActId], references: [id], onDelete: SetNull)

  courseId           String?  // Para facilitar filtros por curso (apenas para documentos)
  createdAt          DateTime @default(now())

  @@unique([userId, documentId, legislativeActId])
  @@index([userId])
  @@index([courseId])
  @@index([legislativeActId])
}

// Posts do Blog
model BlogPost {
  id                 String             @id @default(uuid())
  slug               String             @unique
  title              String
  excerpt            String
  content            String             // Texto longo do artigo
  author             String
  publishedAt        DateTime
  isPublished        Boolean            @default(false)
  tags               String?            // JSON array como string
  leiArticles        String?            // JSON array com números de artigos da Lei 14.133/2021
  autoPublishSocial  Boolean            @default(true) // Publicar automaticamente nas redes sociais
  socialMediaImage   String?            // URL da imagem gerada para OG/redes sociais
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  socialMediaPosts   SocialMediaPost[]  // Relação com publicações sociais

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
}

// Publicações em Redes Sociais
model SocialMediaPost {
  id          String    @id @default(uuid())
  blogPostId  String
  platform    String    // 'instagram' | 'linkedin' | 'twitter'
  postId      String?   // ID do post na rede social
  postUrl     String?   // URL do post publicado
  status      String    @default("pending") // 'pending' | 'published' | 'failed'
  error       String?   // Mensagem de erro se falhar
  retryCount  Int       @default(0) // Número de tentativas
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blogPost    BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([platform])
  @@index([status])
  @@index([publishedAt])
}

// Publicações Acadêmicas (Livros, Artigos, Notícias)
model Publication {
  id          String   @id @default(uuid())
  type        String   // livro, artigo, noticia
  title       String
  description String   // Resumo/descrição
  content     String?  // Conteúdo completo (opcional para artigos externos)
  author      String
  publishedAt DateTime
  isPublished Boolean  @default(false)

  // Campos específicos para livros
  publisher   String?  // Editora
  isbn        String?  // ISBN
  coverImage  String?  // URL da imagem de capa

  // Campos para artigos/links externos
  externalUrl String?  // Link para artigo externo
  journal     String?  // Nome da revista/jornal

  // Campos para notícias/eventos
  eventDate   DateTime? // Data do evento
  location    String?   // Local do evento

  // Catalogação por artigos da Lei 14.133/2021
  leiArticles String?   // JSON array com números de artigos da Lei 14.133/2021

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([type, isPublished])
}

// Formulário de Contato
model ContactForm {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  courseInterest String?  // Nome do curso de interesse
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// Newsletter - Cadastro de Interessados
model NewsletterSubscriber {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  interests      String?  // JSON array com temas de interesse
  isActive       Boolean  @default(true)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([isActive])
  @@index([subscribedAt])
}

// Depoimentos/Testemunhos de Alunos
model Testimonial {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  role           String   // Cargo/função da pessoa
  text           String   // Texto do depoimento
  rating         Int      @default(5) // Avaliação de 1-5 estrelas
  avatar         String   @default("U") // Inicial para avatar
  color          String   @default("from-blue-400 to-blue-600") // Cor do avatar

  // Status de moderação
  status         String   @default("pending") // pending, approved, rejected
  moderatedBy    String?  // ID do admin que moderou
  moderatedAt    DateTime?
  rejectionReason String? // Motivo da rejeição (se aplicável)

  // Relacionamento com formulário de contato (opcional)
  contactFormId  String?  @unique

  // Relacionamento com usuário (se for um aluno logado)
  userId         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Sites Recomendados (compartilhados entre cursos)
model RecommendedSite {
  id          String   @id @default(uuid())
  title       String   // Nome do site
  description String   // Breve descrição do site
  url         String   // URL completa do site
  faviconUrl  String?  // URL do favicon (buscado automaticamente)
  category    String?  // Categoria opcional (jurisprudência, legislação, etc.)
  displayOrder Int     @default(0) // Ordem de exibição
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relação many-to-many com cursos
  courses     SiteToCourse[]

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  @@index([isActive])
  @@index([displayOrder])
}

// Tabela de junção: Sites x Cursos (many-to-many)
model SiteToCourse {
  id             String          @id @default(uuid())
  siteId         String
  courseId       String
  displayOrder   Int             @default(0) // Ordem específica para este curso
  createdAt      DateTime        @default(now())

  site           RecommendedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, courseId])
  @@index([courseId])
  @@index([siteId])
}

// Vídeos do YouTube por curso
model CourseVideo {
  id            String   @id @default(uuid())
  courseId      String   // ID do curso (da lista estática)
  title         String   // Título do vídeo
  description   String?  // Descrição do vídeo
  youtubeUrl    String   // URL completa do YouTube
  youtubeId     String   // ID extraído do YouTube (para embed)
  thumbnailUrl  String?  // URL da thumbnail (gerado automaticamente)
  displayOrder  Int      @default(0) // Ordem de exibição
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamento com lições (LMS)
  lessonVideos LessonVideo[]

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  @@index([courseId])
  @@index([isActive])
  @@index([courseId, isActive, displayOrder])
}

// Analytics de análises automáticas de documentos
model DocumentAnalysis {
  id                String   @id @default(uuid())
  documentId        String?  // ID do documento criado (null se ainda não criado)
  documentTitle     String   // Título do documento analisado
  documentType      String?  // Tipo de arquivo (pdf, docx, etc.)

  // Dados da análise
  textLength        Int      // Quantidade de texto analisado
  pageCount         Int?     // Número de páginas (se PDF)
  citationsFound    Int      @default(0) // Artigos citados explicitamente
  keywordsMatched   Int      @default(0) // Palavras-chave encontradas

  // Sugestões geradas
  suggestedArticles String   // JSON array com artigos sugeridos
  totalSuggestions  Int      @default(0) // Total de sugestões geradas

  // Resultados (o que o usuário aceitou)
  acceptedArticles  String?  // JSON array com artigos aceitos
  acceptedCount     Int      @default(0) // Quantos foram aceitos

  // Métricas calculadas
  precision         Float?   // % de sugestões aceitas (precision)

  // Metadados
  createdAt         DateTime @default(now())
  userId            String?  // Quem fez a análise (opcional)

  @@index([createdAt])
  @@index([documentId])
  @@index([userId])
}

// Glossário de Termos Técnicos
model GlossaryTerm {
  id          String   @id @default(uuid())

  // Identificação
  term        String   @unique // Ex: "Pregão Eletrônico"
  slug        String   @unique // Ex: "pregao-eletronico"

  // Conteúdo
  definition  String   @db.Text // Definição completa
  shortDef    String?  // Definição curta para tooltips

  // Categorização
  category    String?  // Ex: "Modalidade", "Fase", "Documento", "Legislação"

  // Relacionamentos (JSON arrays)
  relatedTerms String? // IDs de termos relacionados
  leiArticles  String? // Artigos da Lei 14.133/2021
  relatedDocs  String? // IDs de documentos relacionados

  // Referências externas
  externalUrl  String? // Link para legislação oficial

  // Analytics
  viewCount    Int      @default(0)

  // Visibilidade
  isPublic     Boolean  @default(true)

  // Auditoria
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  // Email do admin

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  @@index([term])
  @@index([slug])
  @@index([category])
  @@index([isPublic])
}

// Atos Normativos (Decretos, Portarias, INs, etc.)
model LegislativeAct {
  id          String   @id @default(uuid())

  // Identificação do ato
  type        String   // "decreto" | "portaria" | "in" | "ordem-servico" | "lei" | "medida-provisoria"
  number      String   // "10.024" (número do ato)
  year        Int      // 2019 (ano do ato)
  fullNumber  String   @unique // "Decreto 10.024/2019" (identificador completo único)

  // Conteúdo
  title       String   // Título oficial do ato
  ementa      String   @db.Text // Ementa oficial
  summary     String?  @db.Text // Resumo didático para alunos

  // Metadados estruturais
  issuer      String   // "Presidência" | "MGI" | "SEGES" | "AGU" | "TCU" (órgão emissor)
  publishDate DateTime // Data de publicação oficial
  effectiveDate DateTime? // Data de vigência (pode ser diferente da publicação)

  // Hierarquia normativa (1=mais alta, 5=mais baixa)
  hierarchyLevel Int // 1=Lei, 2=Decreto, 3=Portaria, 4=IN, 5=Ordem de Serviço

  // Relacionamento com Lei 14.133/2021
  leiArticles String? // JSON array com números de artigos regulamentados (ex: ["75", "76"])

  // Recursos e documentos
  officialUrl  String? // Link para Planalto/DOU
  pdfUrl       String? // Link para PDF do ato
  content      String? @db.Text // Texto completo do ato (opcional)
  annexesJson  String? @db.Text // JSON array: [{"name":"Anexo I","url":"https://...","type":"pdf"}]

  // Classificação e filtros avançados
  esfera      String  @default("federal")  // "federal" | "estadual"
  themes      String?                       // JSON array: ["planejamento","contratos"]

  // Analytics
  viewCount   Int     @default(0)

  // Scraping e atualização automática
  contentHash       String?   // Hash MD5 para detectar mudanças no texto
  lastScrapedAt     DateTime? // Última tentativa de scraping
  scrapeStatus      String?   // 'success' | 'failed' | 'pending' | 'unchanged'
  scrapeError       String?   @db.Text // Mensagem de erro (se falhou)
  changeDetectedAt  DateTime? // Quando uma mudança foi detectada
  notifyOnChange    Boolean   @default(true) // Notificar admin sobre mudanças

  // Notificações
  notifiedAt  DateTime? // Data em que alunos foram notificados sobre este ato

  // Auditoria
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // Email do admin

  // Sistema de Embeddings/Busca Semântica
  embeddingStatus    String?   // pending|processing|completed|failed
  chunkCount         Int       @default(0) // Número de chunks gerados
  embeddedAt         DateTime? // Data em que os embeddings foram gerados

  // Relacionamento com favoritos
  favorites Favorite[]

  // Relacionamento com chunks (embeddings)
  chunks LegislativeActChunk[]

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  // Índices para otimização
  @@index([type])
  @@index([issuer])
  @@index([year])
  @@index([hierarchyLevel])
  @@index([publishDate])
  @@index([type, issuer])
  @@index([year, type])
  @@index([esfera])
  @@index([notifiedAt])
  @@index([lastScrapedAt])
  @@index([scrapeStatus])
  @@index([embeddingStatus])
}

// Chunks de atos legislativos com embeddings (Busca Semântica)
model LegislativeActChunk {
  id               String   @id @default(uuid())
  legislativeActId String
  legislativeAct   LegislativeAct @relation(fields: [legislativeActId], references: [id], onDelete: Cascade)

  chunkIndex  Int      // Posição no documento (0, 1, 2...)
  content     String   @db.Text // Conteúdo do chunk
  charStart   Int      // Posição inicial no texto original
  charEnd     Int      // Posição final no texto original
  embedding   Unsupported("vector(768)") // Embedding do Gemini gemini-embedding-001

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([legislativeActId])
}

// Perguntas Frequentes (FAQ)
model FAQ {
  id          String   @id @default(uuid())

  // Conteúdo
  question    String   // Pergunta
  answer      String   @db.Text // Resposta (suporta markdown)

  // Categorização
  category    String   // Ex: "Acesso ao Site", "Documentos", "Certificados", "Cursos"

  // Ordem e destaque
  displayOrder Int     @default(0)
  isPinned     Boolean @default(false) // Perguntas destacadas no topo

  // Visibilidade
  isPublished  Boolean @default(true)

  // Analytics
  viewCount    Int     @default(0)
  helpfulCount Int     @default(0)
  notHelpfulCount Int  @default(0)

  // Relacionamentos (JSON arrays)
  relatedFAQs  String? // IDs de FAQs relacionadas
  relatedDocs  String? // IDs de documentos
  keywords     String? // Palavras-chave para busca

  // Relacionamento com feedbacks
  feedbacks FAQFeedback[]

  // Full-Text Search
  search_vector Unsupported("tsvector")?

  // Auditoria
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  // Email do admin

  @@index([category])
  @@index([isPublished])
  @@index([displayOrder])
  @@index([isPinned])
}

// Feedback de FAQ
model FAQFeedback {
  id          String   @id @default(uuid())
  faqId       String
  faq         FAQ      @relation(fields: [faqId], references: [id], onDelete: Cascade)

  wasHelpful  Boolean  // true = útil, false = não útil
  comment     String?  // Feedback opcional do usuário

  // Identificação do usuário
  userEmail   String?  // Se logado
  ip          String?  // IP do usuário

  createdAt   DateTime @default(now())

  @@index([faqId])
  @@index([wasHelpful])
  @@index([createdAt])
}

// Perguntas sobre Artigos da Lei (IA Assistente - Fase 3)
// Armazena histórico de perguntas para analytics e futuro treinamento
model ArticleQuestion {
  id              String   @id @default(uuid())
  articleNumber   String   // Número do artigo (ex: "75")

  // Pergunta do usuário
  question        String   @db.Text

  // Contexto usado para responder (IDs de documentos relevantes)
  contextDocIds   String?  // JSON array com IDs de documentos

  // Resposta (vazio até IA ser ativada)
  answer          String?  @db.Text
  aiProvider      String?  // "anthropic-claude" | "openai" | "gemini" | null

  // Metadados do Gemini (quando gemini usado)
  geminiModel     String?  // Modelo usado (ex: "gemini-2.0-flash-exp")
  geminiTokens    Int?     // Total de tokens usados
  geminiLatency   Int?     // Latência em ms
  geminiCached    Boolean? // Se resposta veio do cache

  // Conversa (para manter contexto entre mensagens)
  conversationId  String?

  // Analytics
  wasHelpful      Boolean? // Feedback do usuário
  feedbackComment String?

  // Identificação do usuário
  userId          String?
  userEmail       String?
  ip              String?

  // Controle
  isPlaceholder   Boolean  @default(true) // true = IA não ativa ainda
  createdAt       DateTime @default(now())
  respondedAt     DateTime? // Quando a IA responder (futuro)

  @@index([articleNumber])
  @@index([conversationId])
  @@index([userId])
  @@index([isPlaceholder])
  @@index([createdAt])
}

// Staging de documentos DOU para aprovação manual
model DOUStagingDocument {
  id String @id @default(uuid())

  // Dados da API DOU
  douId        String  @unique // ID do DOU (classPK)
  title        String
  abstract     String  @db.Text
  url          String
  section      String // do1, do2, do3, doe
  publishDate  String // DD/MM/YYYY
  hierarchyStr String? @db.Text

  // Dados enriquecidos (scraping)
  fullContent String? @db.Text
  edition     String?
  page        String?
  organ       String? @db.Text

  // Classificação automática
  category         String // fonte_agu, ato_normativo, acordao_tcu, etc
  approvalStatus   String // auto_approved, pending, auto_rejected, manually_approved, manually_rejected
  confidence       Int // 0-100
  reasoning        String @db.Text // JSON array de strings
  isRelevant       Boolean
  requiresReview   Boolean

  // Aprovação manual
  reviewedBy   String? // ID do admin que revisou
  reviewedAt   DateTime?
  adminNotes   String? @db.Text
  finalDecision String? // approved ou rejected

  // Importação
  imported      Boolean @default(false)
  importedAt    DateTime?
  documentId    String? // ID do Document criado após importação

  // Controle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
  @@index([category])
  @@index([requiresReview])
  @@index([imported])
  @@index([publishDate])
  @@index([createdAt])
  @@index([reviewedAt])
}

// Filtros personalizados salvos para DOU
model DOUSavedFilter {
  id          String   @id @default(uuid())
  name        String   // Nome do filtro (ex: "AGU Última Semana", "TCU Alto Impacto")
  description String?  // Descrição opcional

  // Configuração do filtro (JSON)
  filterConfig String  @db.Text // JSON com todos os parâmetros do filtro

  // Controle
  createdBy   String   // ID do usuário que criou
  isPublic    Boolean  @default(false) // Se true, todos os admins podem usar
  usageCount  Int      @default(0) // Contador de uso
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdBy])
  @@index([isPublic])
  @@index([lastUsedAt])
}

