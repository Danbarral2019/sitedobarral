{
  "name": "site-prof-barral",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "NODE_OPTIONS=--max-old-space-size=7168 sh -c 'prisma generate && prisma db push && next build'",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "convert-tcu": "node scripts/convert-tcu-excel.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "smoke:coming-soon": "node scripts/smoke-test-coming-soon.mjs",
    "eval:annotate": "dotenv -e .env.local -- tsx eval/cli/annotate.ts",
    "eval:run": "dotenv -e .env.local -- tsx eval/cli/run-baseline.ts",
    "eval:sweep": "dotenv -e .env.local -- tsx eval/cli/sweep-fusion.ts",
    "eval:synthesis": "dotenv -e .env.local -- tsx eval/cli/run-synthesis.ts",
    "eval:planejamento:decision": "tsx eval/planejamento/run-decision.ts",
    "analyze": "ANALYZE=true next build",
    "sync:obsidian": "tsx scripts/sync-obsidian.ts",
    "sync:obsidian:full": "tsx scripts/sync-obsidian.ts --full",
    "export:obsidian": "tsx scripts/sync-obsidian.ts --export-only",
    "import:obsidian": "tsx scripts/sync-obsidian.ts --import-only",
    "migration:api:status": "tsx scripts/api-migration-status.ts",
