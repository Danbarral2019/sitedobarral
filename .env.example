# =============================================================================
# CONFIGURAÇÃO DO SITE DO PROF. DANIEL BARRAL
# =============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais reais
# NUNCA faça commit do arquivo .env.local (já está no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Prisma)
# -----------------------------------------------------------------------------
# DESENVOLVIMENTO LOCAL - Opção 1: PostgreSQL local (Docker)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profbarral?schema=public"

# DESENVOLVIMENTO LOCAL - Opção 2: PostgreSQL gratuito (Neon/Supabase)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Banco remoto isolado para testes E2E. Nunca apontar para produção.
TEST_DATABASE_URL=

# PRODUÇÃO - PostgreSQL Neon configurado nas Environment Variables da Vercel
# DATABASE_URL=

# O schema usa PostgreSQL e a extensão vector em todos os ambientes.

# -----------------------------------------------------------------------------
# JWT / AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Chave secreta para assinar tokens JWT
# IMPORTANTE: Use uma chave forte e aleatória em produção (mínimo 32 caracteres)
# Você pode gerar uma em: https://generate-secret.vercel.app/32
JWT_SECRET=

# -----------------------------------------------------------------------------
# ADMIN (Primeiro acesso)
# -----------------------------------------------------------------------------
# Credenciais usadas apenas pelo script de bootstrap do primeiro administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# RESEND (Serviço de Email)
# -----------------------------------------------------------------------------
# 1. Crie conta gratuita em: https://resend.com
# 2. Verifique o domínio canônico do site
# 3. Crie uma API Key em: Dashboard → API Keys → Create API Key
# 4. Cole a chave abaixo (formato: re_xxxxxxxxxxxxx)

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# Email para receber notificações de sistema (opcional)
# EMAIL_NOTIFICATIONS=

# -----------------------------------------------------------------------------
# ANTHROPIC CLAUDE API (Análise Semântica Avançada - OPCIONAL)
# -----------------------------------------------------------------------------
# FASE 4: IA para melhorar precisão das sugestões automáticas de artigos
# 1. Crie conta em: https://console.anthropic.com
# 2. Gere uma API Key em: Settings → API Keys
# 3. Cole a chave abaixo (formato: sk-ant-xxxxxxxxxxxxx)
#
# NOTA: Este recurso é OPCIONAL. Se não configurado, apenas análise básica
# (citações + palavras-chave) será usada. Claude é usado como fallback quando
# análise básica tem baixa confiança (<3 sugestões ou <30% alta confiança).
#
# CUSTO: Claude Haiku (~$0.25 por milhão de tokens de input)
# Um documento médio (10 páginas) usa ~5000 tokens ≈ $0.0013 por análise

# ANTHROPIC_API_KEY=sk-ant-sua_chave_aqui
ANTHROPIC_API_KEY=
COHERE_API_KEY=
DATAJUD_API_KEY=

# Roteamento e limites de IA
AI_CHAT_PROVIDER=
AI_CLASSIFICATION_PROVIDER=
AI_CLASSIFICATION_MODEL=
AI_ENHANCEMENT_PROVIDER=
AI_ENHANCEMENT_MODEL=
AI_SEARCH_PROVIDER=
AI_SEARCH_MODEL=
AI_SYNTHESIS_MODEL=
AI_DAILY_GLOBAL_CAP=
EMBEDDING_MODEL=
RERANK_PROVIDER=
DETECT_AMENDMENTS_AI=

# -----------------------------------------------------------------------------
# CRON JOB (Verificação de Expiração de Matrículas)
# -----------------------------------------------------------------------------
# Chave secreta para proteger o endpoint de cron job
# Usado para evitar que terceiros executem a verificação de expiração
# Você pode gerar em: https://generate-secret.vercel.app/32
CRON_SECRET=

# Runner do STF (GitHub Actions) — URL da rota de ingestão em produção.
# Usada só pelo workflow .github/workflows/stf-jurisprudencia.yml.
# Configurar também como secret no repositório do GitHub, junto de CRON_SECRET.
STF_INGEST_URL=

# -----------------------------------------------------------------------------
# NEXT.JS / APLICAÇÃO
# -----------------------------------------------------------------------------
# URL base do site (usado para gerar links absolutos em emails)
# Desenvolvimento local:
NEXT_PUBLIC_BASE_URL=

# Para testar no celular na mesma rede (substitua pelo IP da sua máquina):
# NEXT_PUBLIC_BASE_URL=http://192.168.1.100:3000

# Produção: https://profdanielbarral.com

# -----------------------------------------------------------------------------
# VERCEL (Deploy em Produção)
# -----------------------------------------------------------------------------
# Estas variáveis são configuradas automaticamente pelo Vercel
# Não precisa definir manualmente

# VERCEL_URL - URL automática do projeto
# VERCEL_ENV - production, preview ou development

# -----------------------------------------------------------------------------
# MAILCHIMP (Newsletter / Email Marketing)
# -----------------------------------------------------------------------------
# 1. Crie conta em: https://mailchimp.com
# 2. Obtenha API Key em: Account > Extras > API keys
# 3. Server Prefix: é o sufixo do seu API key (ex: us1, us2, etc.)
# 4. Audience ID: Audience > Settings > Audience name and defaults

MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_REPLY_TO=

# -----------------------------------------------------------------------------
# OPCIONAL: ANALYTICS / MONITORAMENTO
# -----------------------------------------------------------------------------
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (monitoramento de erros)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# GEMINI API KEYS (Chat RAG + Busca IA + Embeddings)
# -----------------------------------------------------------------------------
# Chave do projeto principal Google AI Studio (https://aistudio.google.com/app/apikey).
# Usada em todas as chamadas Gemini: chat, síntese de busca, embeddings,
# classificação DOU, relevance-filter da newsletter etc.
GEMINI_API_KEY=

# Chave de backup (opcional, mas RECOMENDADO em produção). Quando a primária
# retorna 429/RESOURCE_EXHAUSTED, o sistema tenta automaticamente a backup
# antes de degradar para FTS-only. Crie como projeto Google AI separado.
# Sem essa env, comportamento é idêntico ao anterior: 1 tentativa só.
# GEMINI_API_KEY_BACKUP=

# -----------------------------------------------------------------------------
# GEMINI MODEL OVERRIDE (rollback rápido sem deploy)
# -----------------------------------------------------------------------------
# Default: gemini-3-flash-preview (sucessor de gemini-2.5-flash, GA dez/2025)
# - Fallback automático em caso de erro: gemini-2.5-flash → 2.5-flash-lite → 1.5-flash
# - 2.5-flash deprecação anunciada para 17/jun/2026; após esse prazo, fallback
#   pula para 2.5-flash-lite
# Para forçar volta ao 2.5 (rollback de emergência):
#   GEMINI_PRIMARY_MODEL=gemini-2.5-flash
# GEMINI_PRIMARY_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# GEMINI PREMIUM (3.1 Pro) — feature flag cirúrgico
# -----------------------------------------------------------------------------
# Modelo premium opcional para queries de raciocínio profundo. ~6x mais caro
# que Flash, então só ativar onde compense.
# GEMINI_PREMIUM_MODEL=gemini-3.1-pro-preview
#
# Roteamento de chat de artigos: quando ON, /api/artigos/[numero]/chat usa
# Pro em queries que combinem (a) ≥200 chars OU (b) verbos analíticos
# (compare/relacione/interprete/fundamente/diferencie/implicações/...).
# Demais queries continuam em Flash.
# USE_PREMIUM_FOR_CHAT=false
#
# Detector IA de relações entre atos (cron semanal + import batch): quando
# ON, lib/legislative-acts/amendment-detector-ai usa Pro com thinking
# ativo. Volume baixo (~10 atos/semana), custo previsível.
# USE_PREMIUM_FOR_DETECTOR=false

# -----------------------------------------------------------------------------
# SEARCH ANALYTICS (kill switch)
# -----------------------------------------------------------------------------
# Liga/desliga a coleta de SearchHistory (queries, sources, feedback 👍/👎).
# - Default: enabled (não definir = ligado).
# - Para pausar a coleta em produção sem deploy: SEARCH_ANALYTICS_ENABLED=false
# Quando desligado, POST /api/area-restrita/search-history retorna 200 com
# { id: null, disabled: true } sem gravar no DB. Dados históricos permanecem
# acessíveis em /admin/search-analytics. Feedback PATCH em entradas existentes
# continua funcionando.
# SEARCH_ANALYTICS_ENABLED=true
DISABLE_CACHE=
LOG_LEVEL=

# -----------------------------------------------------------------------------
# OPCIONAL: STORAGE / UPLOAD DE ARQUIVOS
# -----------------------------------------------------------------------------
# Para produção, você pode usar serviços como AWS S3, Cloudflare R2, etc.
# Desenvolvimento usa pasta local public/uploads

# AWS S3 (exemplo)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Cloudflare R2 (exemplo)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# MCP SERVERS (Model Context Protocol) - CLAUDE CODE
# -----------------------------------------------------------------------------
# MCPs permitem que Claude Code interaja com ferramentas externas
# Instalados via CLI: claude mcp add <name> <command>
# Ver documentação completa em: MCP_SETUP.md

# MCPs Ativos:
# ✅ Playwright - Browser automation (scope: user)
# ✅ PostgreSQL - Direct database queries (scope: local, usa DATABASE_URL acima)
# ✅ GitHub - Repository management (scope: user, usa GITHUB_PERSONAL_ACCESS_TOKEN)

# GitHub MCP - Personal Access Token
# 1. Criar em: https://github.com/settings/tokens
# 2. Escopos necessários: repo, workflow, read:org
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_sua_chave_aqui

# NOTA: Credenciais do PostgreSQL MCP usam a DATABASE_URL acima
# NOTA: Playwright não requer configuração adicional

# Comandos úteis:
# claude mcp list              # Listar MCPs instalados
# claude mcp get <name>        # Ver detalhes de um MCP
# claude mcp remove <name>     # Remover MCP

# -----------------------------------------------------------------------------
# DESENVOLVIMENTO
# -----------------------------------------------------------------------------
# Porta do servidor (padrão: 3000)
# PORT=3000

# Modo de desenvolvimento
# NODE_ENV=development
# NODE_ENV=production
NEXTAUTH_SECRET=

# Arquivos usados apenas por scripts locais de importação
STF_DADOS_JSON=
TST_LIVRO_RTF=
TST_SUMULAS_PDF=

# -----------------------------------------------------------------------------
# UPSTASH REDIS (Cache & Rate Limiting)
# -----------------------------------------------------------------------------
# 1. Crie conta gratuita em: https://console.upstash.com/
# 2. Crie um Redis database:
#    - Name: profbarral-cache
#    - Type: Regional
#    - Region: us-east-1 (ou mais proximo)
#    - Eviction: allkeys-lru
# 3. Copie as credenciais REST API

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (PWA - Web Push)
# -----------------------------------------------------------------------------
# Gere as chaves VAPID com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY e NEXT_PUBLIC_VAPID_PUBLIC_KEY devem ter o mesmo valor

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Publicação em redes sociais
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# -----------------------------------------------------------------------------
# STRIPE (Pagamentos - Cartão + Pix Automático via Checkout + Subscriptions)
# -----------------------------------------------------------------------------
# 1. Crie conta em: https://dashboard.stripe.com
# 2. Ative Pix Automático (Brasil) em Settings > Payment methods.
# 3. Copie a Secret Key (test mode em desenvolvimento):
#    - TEST: sk_test_...
#    - PROD: sk_live_...
# 4. Rode `tsx scripts/stripe-bootstrap.ts` para criar Products e Prices
#    (idempotente, usa lookup_keys).
# 5. Cadastre o webhook em Developers > Webhooks:
#    URL: https://profdanielbarral.com/api/pagamento/webhook
#    Eventos: checkout.session.completed, invoice.paid, invoice.payment_failed,
#             customer.subscription.updated, customer.subscription.deleted,
#             charge.refunded, charge.dispute.created
#    Copie o Signing Secret (whsec_...).

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reserva para uso futuro com Stripe Elements; não é necessário para Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Preços exibidos no frontend (apenas para display — a fonte de verdade é o Stripe)
NEXT_PUBLIC_PRICE_BASICO=
NEXT_PUBLIC_PRICE_BASICO_ANUAL=
NEXT_PUBLIC_PRICE_PREMIUM=
NEXT_PUBLIC_PRICE_PREMIUM_ANUAL=

# Habilita PIX (Pix Automático) no checkout. Default desabilitado: o Pix Automático
# é "invite only" no Brasil e exige histórico de processamento na conta Stripe.
# Setar como "true" SOMENTE depois de a Stripe liberar a capability pix_payments.
# Ver lib/payments/config.ts.
NEXT_PUBLIC_PIX_ENABLED=false

# -----------------------------------------------------------------------------
# CLIPPING DIÁRIO MULTI-TRIBUNAL
# -----------------------------------------------------------------------------
# Lista CSV de destinatários administrativos que sempre recebem o clipping,
# independente de Subscription/Enrollment. Aceita "email@x.com" ou "Nome <email@x.com>".
CLIPPING_ADMIN_RECIPIENTS=
# Filtro beta opcional: se setado, só envia para emails desta lista (alunos).
# Admins do CLIPPING_ADMIN_RECIPIENTS sempre passam.
CLIPPING_BETA_EMAILS=
# Secret HMAC para o link de cancelamento (fallback: NEXTAUTH_SECRET / CRON_SECRET).
CLIPPING_UNSUBSCRIBE_SECRET=
# Secret HMAC do "Ver no navegador" — pode usar o mesmo do unsubscribe.
CLIPPING_VIEW_SECRET=
# "true" para mostrar banner de novidade no email (avisa sobre o arquivo). Remova quando não precisar mais.
CLIPPING_NEW_FEATURE_BANNER=
# Lista CSV de tribunais habilitados no clipping multi-tribunal. Default "TCU".
# Códigos suportados: TCU, TCE-PE, TCE-RS, TCE-SP, TCE-PR, TCE-SC, TCE-RJ, STF, STJ
# Rollout incremental sugerido: TCU → TCU,TCE-PE → +STF → +demais.
CLIPPING_TRIBUNAIS_ENABLED=TCU
# Janela em dias para tribunais não-TCU (busca decisões criadas nos últimos N dias).
# Default 14. TCU permanece com janela própria de 24h (dias úteis).
CLIPPING_WINDOW_DAYS=14
# Limite de decisões por tribunal por edição. Default 5.
CLIPPING_MAX_ITEMS_PER_TRIBUNAL=5
# Cap global do total de decisões por edição (anti-clipping do Gmail @ 100KB).
# Quando excedido, mantém top-N por relevanceScore. Default 15.
CLIPPING_MAX_ITEMS_TOTAL=15
# Idade maxima do julgado no clipping, em meses, medida pela dataJulgamento.
# Default 3. Existe porque `CLIPPING_WINDOW_DAYS` mede `createdAt` (novidade
# para nos) e nao a idade do julgado: um backfill de acervo torna elegivel o
# historico inteiro de uma vez, e o clipping diario passa a enviar julgado de
# 2022 como se fosse do dia. Nao troque a janela por dataJulgamento — STF e STJ
# sao coletados uma vez por mes e sumiriam do clipping.
# Decisao sem dataJulgamento nunca entra.
CLIPPING_MAX_IDADE_MESES=3
# Teto de caracteres por ementa no corpo do e-mail. Default 2000 — o cap acima
# limita a QUANTIDADE de itens, este limita o TAMANHO de cada um (o STF tem
# ementa mediana de 5,5 mil chars, com máximo observado de 31 mil). O texto
# integral segue no link de inteiro teor.
CLIPPING_EMENTA_MAX_CHARS=2000
# IA de enriquecimento (bullets "Contexto e tese") usa GEMINI_API_KEY automaticamente.
# TCU: acionada por heurística quando dispositivos extraídos são poucos/secos.
# TribunalDecision: acionada quando fullText >= 800 chars (TCE-PE rico; TCE-RS curto).
# Sem chave, o cron continua, apenas sem bullets editoriais.

# -----------------------------------------------------------------------------
# COMING-SOON DE PRÉ-LANÇAMENTO
# -----------------------------------------------------------------------------
# Quando "true", todas as rotas vitrine (homepage, /sobre, /lei-14133, /cursos, etc.)
# são reescritas para /coming-soon para visitantes anônimos. Rotas operacionais
# (login, área-restrita, admin, api, blog, certificado) ficam intactas. Usuários
# logados (qualquer role) fazem bypass automaticamente.
COMING_SOON_ENABLED="false"

# Chave secreta para bypass via /preview?key=XXX. Cookie httpOnly de 60 dias.
# Gerar com: openssl rand -hex 32
# Trocar essa env var invalida todos os cookies preview-bypass emitidos.
PREVIEW_BYPASS_KEY=""
