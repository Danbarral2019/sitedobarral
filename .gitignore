# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
.env.local.backup*
.env.local.bak*

# IMPORTANTE: .env.example DEVE ser commitado (é o template)
!.env.example

# Claude Code MCP settings com chaves API (NUNCA COMMITAR)
.claude/settings.local.json
.claude/*.local.json
*settings.local.json
*.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads
/public/uploads

# backups automáticos (gerados por scripts)
data/backups/

/lib/generated/prisma
*.db

.vercel
nul

# Scripts de configuração com chaves/secrets (NUNCA COMMITAR)
*-definitivo.ps1
*-definit*.ps1
configurar-*-key*.ps1
configurar-api*.ps1
setup-keys.*
config-secrets.*
*-secret.ps1
*-keys.ps1

# MCP Server - Arquivos de teste com potencial de API keys
mcp-server-gemini/test-*.mjs
mcp-server-gemini/*-test.mjs
!mcp-server-gemini/*.example.*
.env.production

# Output de scripts (artefatos de execução)
scripts/output/

# Obsidian sync state (local, por desenvolvedor)
.obsidian-sync-state.json

# CONUNI snapshot (3.7MB, regenerável via sync-conuni.ts --refetch)
data/conuni-snapshot.json

# Lighthouse reports (output de auditoria, não versionados)
lighthouse-report.report.*

# Build logs (output local, não versionados)
build-*.log

# JSONs na raiz: bloquear por default (snapshots, reports, dumps gerados por
# scripts ad-hoc). Whitelist os arquivos legítimos do projeto.
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/vercel.json

# AGU scraper test outputs
agu-scraper-v4-import.json
agu-scraper-v4-report.csv
dev.log
